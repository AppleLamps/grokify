# Neon Database
# Get your connection string from https://console.neon.tech
DATABASE_URL=

# xAI API Key (for Grok)
# Get your API key from https://console.x.ai
XAI_API_KEY=

# OpenRouter API Key (for Gemini image generation)
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=

# GetImg.ai API Key (for Flux Schnell fallback)
# Get your API key from https://getimg.ai
GETIMG_API_KEY=

# X Bot Integration
# Get your keys from https://developer.x.com/en/portal/dashboard
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
X_BOT_HANDLE=

# Vercel Cron Secret (used to authenticate cron job requests)
CRON_SECRET=
