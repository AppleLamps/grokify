# Public site (SEO, Open Graph, OpenRouter referer). Production: https://www.grokify.ai
NEXT_PUBLIC_BASE_URL=https://www.grokify.ai
NEXT_PUBLIC_APP_URL=https://www.grokify.ai

# Neon Database
# Get your connection string from https://console.neon.tech
DATABASE_URL=

# xAI API Key (for Grok)
# Get your API key from https://console.x.ai
XAI_API_KEY=

# Grok Imagine feature flags (disabled by default unless explicitly true)
NEXT_PUBLIC_GROK_IMAGE_GENERATION_ENABLED=false
NEXT_PUBLIC_GROK_VIDEO_GENERATION_ENABLED=false

# OpenRouter API Key (for Gemini image generation and Grokify Prompt)
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=

# Vercel Blob upload controls
BLOB_READ_WRITE_TOKEN=
UPLOAD_INTENT_SECRET=
UPLOAD_IMAGE_DAILY_LIMIT=20
UPLOAD_VIDEO_DAILY_LIMIT=10
UPLOAD_VIDEO_INTENT_DAILY_LIMIT=20
UPLOAD_VIDEO_TOKEN_DAILY_LIMIT=20

# Debug raw AI payload metadata only outside production. Never enable in production.
DEBUG_AI_PAYLOADS=false

# GetImg.ai API Key (for Flux Schnell fallback)
# Get your API key from https://getimg.ai
GETIMG_API_KEY=

# X Bot Integration
# Get your keys from https://developer.x.com/en/portal/dashboard
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
X_BOT_HANDLE=

# Vercel Cron Secret (used to authenticate cron job requests)
CRON_SECRET=
